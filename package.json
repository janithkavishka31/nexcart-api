{
    "name":  "nexcart-api",
    "version":  "0.1.0",
    "description":  "Production-ready modular e-commerce backend API built with Express, Prisma, and PostgreSQL.",
    "main":  "src/server.js",
    "scripts":  {
                    "dev":  "nodemon src/server.js",
                    "start":  "node src/server.js",
                    "lint":  "eslint .",
                    "format":  "prettier --write .",
                    "prisma:generate":  "prisma generate --schema=src/prisma/schema.prisma",
                    "prisma:migrate":  "prisma migrate dev --schema=src/prisma/schema.prisma",
                    "prisma:studio":  "prisma studio --schema=src/prisma/schema.prisma",
                    "prisma:backfill-category-images":  "node src/prisma/backfillCategoryImages.js",
                    "prisma:seed":  "node src/prisma/seed.js"
                },
    "keywords":  [
                     "ecommerce",
                     "api",
                     "express",
                     "postgresql",
                     "prisma"
                 ],
    "author":  "Janith Kavishka \u003cjanithnadiranga@gmail.com\u003e",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/janithkavishka31/nexcart-api.git"
                   },
    "bugs":  {
                 "url":  "https://github.com/janithkavishka31/nexcart-api/issues"
             },
    "homepage":  "https://github.com/janithkavishka31/nexcart-api#readme",
    "license":  "ISC",
    "type":  "commonjs",
    "dependencies":  {
                         "cookie-parser":  "^1.4.7",
                         "cors":  "^2.8.6",
                         "dotenv":  "^17.4.2",
                         "express":  "^5.2.1",
                         "express-rate-limit":  "^8.5.2",
                         "helmet":  "^8.2.0",
                         "@prisma/adapter-pg":  "^7.8.0",
                         "@prisma/client":  "^7.8.0",
                         "pg":  "^8.21.0",
                         "bcrypt":  "^6.0.0",
                         "jsonwebtoken":  "^9.0.3",
                         "zod":  "^4.4.3",
                         "multer":  "^2.2.0"
                     },
    "devDependencies":  {
                            "eslint":  "^10.4.1",
                            "eslint-config-prettier":  "^10.1.8",
                            "nodemon":  "^3.1.14",
                            "prettier":  "^3.8.3",
                            "prisma":  "^7.8.0"
                        },
    "prisma":  {
                   "seed":  "node src/prisma/seed.js"
               }
}
